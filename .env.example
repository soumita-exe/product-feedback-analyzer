# ─────────────────────────────────────────────────────────────
# Product Feedback Analyzer — environment variables template
#
# How to use:
#   1. Get a free API key at https://aistudio.google.com/apikey
#   2. Copy this file to a new file named ".env":
#        copy .env.example .env      (Windows)
#        cp .env.example .env        (macOS / Linux)
#   3. Paste your real key after GEMINI_API_KEY= in ".env".
#
# SECURITY:
#   - This file contains NO secrets and is safe to commit.
#   - Your real ".env" is git-ignored and must NEVER be committed.
#   - The key is read ONLY by server-side code (the /api/analyze
#     route). It is never sent to the browser.
#
# DEMO MODE:
#   - Leave GEMINI_API_KEY empty to run the app without AI.
#     A local fallback analyzer powers the app so you can demo
#     everything with no key and no internet AI calls.
# ─────────────────────────────────────────────────────────────

GEMINI_API_KEY=

# ── Optional: override the Gemini API base URL ────────────────
# Only needed for advanced setups (e.g. a local mock server for
# testing). Leave this line unchanged for normal use.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
